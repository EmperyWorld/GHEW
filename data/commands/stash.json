{
  "commands": [
    {
      "id": "stash_push",
      "group": "stash",
      "title": "Stash сохранить",
      "synopsis": "git stash push -m <msg>",
      "danger": "mutates",
      "preview": "stash",
      "git": ["stash", "push"],
      "params": [
        {
          "name": "message",
          "label": "Сообщение",
          "type": "string",
          "flag": "-m",
          "default": "wip"
        },
        {
          "name": "includeUntracked",
          "label": "Включить untracked (-u)",
          "type": "bool",
          "flag": "-u",
          "default": false
        }
      ],
      "explanation": "## Что делает\n\nПрячет локальные изменения в stash и очищает рабочее дерево.\n\n## Риски\n\nЛегко забыть про stash; untracked по умолчанию не всегда входят."
    },
    {
      "id": "stash_list",
      "group": "stash",
      "title": "Stash список",
      "synopsis": "git stash list",
      "danger": "safe",
      "preview": "stash",
      "git": ["stash", "list"],
      "params": [],
      "explanation": "## Что делает\n\nПоказывает сохранённые stash-записи."
    },
    {
      "id": "stash_pop",
      "group": "stash",
      "title": "Stash pop",
      "synopsis": "git stash pop",
      "danger": "mutates",
      "preview": "stash",
      "git": ["stash", "pop"],
      "params": [],
      "explanation": "## Что делает\n\nПрименяет последний stash и удаляет его из списка.\n\n## Риски\n\nКонфликты; запись stash пропадёт даже при частичном успехе (зависит от версии/флагов)."
    },
    {
